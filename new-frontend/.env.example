# ============================================================
# AmbuCast Frontend — Environment Variables
# Copy this file to .env.local for local dev
# ============================================================

# ─── API Endpoints ───────────────────────────────────────────
# Local dev:    http://localhost:3001/api
# Render (prod): https://ambucast-backend.onrender.com/api
VITE_API_URL=http://localhost:3001/api

# Local dev:    http://localhost:8000
# Render (prod): https://ambucast-ml-api.onrender.com
VITE_ML_API_URL=http://localhost:8000

# Local dev:    http://localhost:3001
# Render (prod): https://ambucast-backend.onrender.com
VITE_SOCKET_URL=http://localhost:3001

# ─── Map Config (Default: Delhi, India) ──────────────────────
VITE_MAP_CENTER_LAT=28.6139
VITE_MAP_CENTER_LNG=77.2090
VITE_MAP_ZOOM=12
