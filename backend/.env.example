# ============================================================
# AmbuCast Backend — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ─── Database ────────────────────────────────────────────────
# Local (with Docker):  postgresql://user:password@localhost:5432/ambucast_db
# Neon.tech (prod):     postgresql://user:password@ep-xxxx.neon.tech/ambucast_db?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/ambucast_db"

# ─── ML API ──────────────────────────────────────────────────
# Local dev:    http://localhost:8000
# Render (prod): https://ambucast-ml-api.onrender.com
ML_API_URL=http://localhost:8000
ML_API_ENABLED=true
ML_API_TIMEOUT=10000

# ─── OpenWeather API ─────────────────────────────────────────
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# ─── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── CORS ────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slash)
# Local: leave empty (localhost origins are always allowed)
# Prod:  https://ambucast-frontend.onrender.com
CORS_ORIGIN=
