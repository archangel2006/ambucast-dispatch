model Hotspot {
  id             String   @id @default(cuid())
  zone_id        String
  area           String
  lat            Float
  lng            Float
  predicted_calls Int
  risk_score     Float
  risk_class     String
  timestamp      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Prediction {
  id        String   @id @default(cuid())
  data      Json
  createdAt DateTime @default(now())
}

model Ambulance {
  id        String   @id @default(cuid())
  lat       Float
  lng       Float
  status    AmbulanceStatus @default(AVAILABLE)
  zoneId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AmbulanceStatus {
  AVAILABLE
  BUSY
  MOVING
}